	],
	"selam_yasli": [
		"Kolay gelsin evladım.",
		"Hayırlı işler evladım.",
		"Selamünaleyküm evladım.",
		"Allah kolaylık versin evladım."
	],
	"laf": [
		"Sabahtan beri sıradayım.",
		"Dışarıda ayaz var, içerisi iyiymiş.",
		"Otobüsüm on ikide kalkıyor.",
		"Muhtar, kâğıtların tamam olduğunu söyledi.",
		"Üçüncü gelişim bu.",
		"Evrakı dün akşam hazırladım.",
		"Çocuk okuldan çıkmadan döneyim diyorum.",
		"Dükkânı çırağa bıraktım, acelem var.",
		"Köyden geldim, akşama dönmem lazım.",
		"Kardan yollar kapanmadan yetişeyim."
	],
	"onay": [
		"Allah razı olsun.",
		"Eksik olmayın efendim.",
		"Sağ olun, hayırlı işler.",
		"Elinize sağlık.",
		"Oh, şükür. Hayırlı günler.",
		"Çok teşekkür ederim.",
		"Bu iş de bitti, şükür."
	],
	"onay_yasli": [
		"Eline sağlık evladım.",
		"Allah tuttuğunu altın etsin.",
		"Çok yaşa evladım."
	],
	"eksik": [
		"Yine mi? Üçüncü gelişim bu!",
		"Peki efendim, tamamlayıp gelirim.",
		"Muhtara soracağım bunu.",
		"Bir kâğıt için yine yol tepeceğiz.",
		"Bu memlekette iş bir günde bitmez zaten.",
		"Neresi eksikmiş, anlamadım ki...",
		"Hay Allah. Yarın yine gelirim.",
		"Canınız sağ olsun, gider getiririm."
	],
	"eksik_yasli": [
		"Bu yaşta beni yollarda süründürme evladım.",
		"Peki evladım, yarın yine gelirim.",
		"Gözlerim görmüyor, kim yazdıysa yanlış yazmış."
	],
	"havale": [
		"Müdür Bey'e mi? Hayırdır?",
		"Peki efendim, bekliyorum.",
		"Bir yanlışlık olmasın sakın.",
		"Müdürün odası şu kapı mı?"
	],
	"alarm": [
		"O çanta benim değil! Emanet almıştım!",
		"Bir yanlışlık var! Kim koymuş onu oraya?",
		"Vallahi haberim yok, garajda biri elime tutuşturdu!",
		"Bırakın kolumu! Avukatımı isterim!"
	],
	"alarm_bos": [
		"Çantamı didik didik ettiniz; bulduğunuz bu mu?",
		"Otobüsü kaçırırsam hesabını sizden sorarım.",
		"Her şeyi karıştırdınız. Kim toplayacak şimdi?",
		"Bir çantaya bu kadar şüphe... Hayırdır memur bey?",
		"Koca devlet, benim çantamla uğraşıyor."
	],
